~~ =====================================================================
~~  Sreon — embed
~~
~~  Pages are made of CSS and a little script. This tool reads the files
~~  in ui/ and writes engine/assets.spf: each file as one raw text
~~  constant (r"""...""", a literal Sreon added to the language: no
~~  escapes, no holes, braces mean themselves) with an accessor function.
~~
~~      sprfst run tools/embed.spf
~~ =====================================================================
use std.io
use std.fs

fn main() {
    var out = "~~ Generated by tools/embed.spf from ui/. Edit the files in ui/, then run it again.\n"
    out = out + "module assets\n\n"
    var files = fs.list("ui")
    files = files.sort()
    var count = 0
    for file in files {
        if not (file.ends_with(".css") or file.ends_with(".js") or file.ends_with(".svg")) { skip }
        let body = fs.read("ui/" + file) ?? ""
        let name = file.replace(".", "_").replace("-", "_").upper()
        out = out + "const " + name + " = r\"\"\"" + body + "\"\"\"\n"
        out = out + "pub fn " + name.lower() + "() -> Text => " + name + "\n\n"
        count = count + 1
    }
    fs.write("engine/assets.spf", out)
    io.say("embedded {count} files into engine/assets.spf")
}
