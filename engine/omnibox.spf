~~ ------------------------------------------------------- suggestions
fn contains_all(hay: Text, words: [Text]) -> Bool {
    let h = hay.lower()
    for w in words { if not h.contains(w) { give false } }
    give true
}

fn score_of(title: Text, url: Text, words: [Text]) -> Int {
    let t = title.lower()
    let u = url.lower()
    var score = 0
    for w in words {
        if t.starts_with(w) { score = score + 40 }
        else if t.contains(" " + w) { score = score + 25 }
        else if t.contains(w) { score = score + 12 }
        if kit.site_of(url).starts_with(w) { score = score + 35 }
        else if u.contains(w) { score = score + 8 }
    }
    give score
}

object Scored {
    score: Int = 0
    item: state.Item = state.Item { }
}

fn top(list: [Scored], n: Int) -> [state.Item] {
    let sorted = list.sort_by(fn(x, y) => x.score > y.score)
    var out: [state.Item] = []
    var i = 0
    while i < sorted.len() and i < n { out.push(sorted[i].item); i = i + 1 }
    give out
}

pub fn suggest(a: state.App, input: Text) -> [state.Item] {
    var out: [state.Item] = []
    var q = input.trim()
    var mode = "all"
    if q.starts_with(">") { mode = "commands"; q = q.slice(1, q.len()).trim() }
    else if q.starts_with("@") { mode = "tabs"; q = q.slice(1, q.len()).trim() }
    else if q.starts_with("#") { mode = "bookmarks"; q = q.slice(1, q.len()).trim() }
    else if q.starts_with("/") and q.len() > 1 and not q.slice(1, q.len()).contains("/") and false { mode = "history" }
    let words = kit.words_of(q.lower())
    let tools_on = settings.flag(a.s, "suggest_tools")

    if mode == "all" and q != "" and tools_on {
        let r = units.answer(q)
        if r.ok {
            out.push(state.Item { kind: "answer", icon: "calc", title: r.text, sub: if r.note != "" { r.note + " · press Enter to copy" } else { "Answer · press Enter to copy" }, act: "copy", arg: r.text })
        }
    }
    if mode == "all" and q != "" {
        let v = classify(a, q)
        if v.kind == "url" {
            out.push(state.Item { kind: "url", icon: "globe", title: "Go to " + pretty_host(v.url), sub: v.url, act: "open", arg: v.url, hint: "Open" })
        } else if v.kind == "keyword" {
            out.push(state.Item { kind: "keyword", icon: "search", title: "Search " + v.label + " for “" + q.slice(q.index_of(" ") + 1, q.len()) + "”", sub: pretty_host(v.url), act: "open", arg: v.url, hint: v.label })
        } else if v.kind == "internal" {
            out.push(state.Item { kind: "url", icon: "spark", title: "Open " + v.url, sub: "Sreon page", act: "open", arg: v.url })
        } else {
            out.push(state.Item { kind: "search", icon: "search", title: "Search with Sreon for “" + q + "”", sub: "Private search · " + settings.str(a.s, "engine") + " results", act: "open", arg: v.url, hint: "Search" })
        }
    }

    if mode == "all" or mode == "tabs" {
        var found: [Scored] = []
        for t in a.tabs {
            if q == "" or contains_all(t.title + " " + t.url, words) {
                var bonus = 5
                if t.id == a.active { bonus = 0 }
                var note = "Switch to tab"
                if t.sleeping { note = "Sleeping" }
                var it = state.Item { kind: "tab", icon: "", title: state.brand_title(t.title, t.url), sub: pretty_host(t.url), act: "tab.select", arg: t.id.to_text(), hint: note, hue: kit.hue_of(kit.site_of(t.url)) }
                found.push(Scored { score: score_of(t.title, t.url, words) + bonus, item: it })
            }
        }
        var lim_t = 4
        if mode == "tabs" { lim_t = 12 }
        for it in top(found, lim_t) { out.push(it) }
    }

    if mode == "all" or mode == "bookmarks" {
        var found: [Scored] = []
        for b in a.bookmarks {
            let m: Map<Text, Any> = b
            let title = kit.gt(m, "t")
            let url = kit.gt(m, "u")
            if q == "" or contains_all(title + " " + url, words) {
                found.push(Scored { score: score_of(title, url, words) + 10, item: state.Item { kind: "bookmark", icon: "star", title: title, sub: pretty_host(url), act: "open", arg: url, hint: "Bookmark", hue: kit.hue_of(kit.site_of(url)) } })
            }
        }
        var lim_b = 3
        if mode == "bookmarks" { lim_b = 12 }
        for it in top(found, lim_b) { out.push(it) }
    }

    if (mode == "all" and q != "" and settings.flag(a.s, "suggest")) {
        var found: [Scored] = []
        var seen: Map<Text, Any> = [:]
        var i = a.history.len() - 1
        var looked = 0
        while i >= 0 and looked < 2500 {
            let m: Map<Text, Any> = a.history[i]
            let url = kit.gt(m, "u")
            let title = kit.gt(m, "t")
            looked = looked + 1
            i = i - 1
            if seen.has(url) { skip }
            if contains_all(title + " " + url, words) {
                seen.set(url, 1)
                let visits = kit.gi(m, "n", 1)
                found.push(Scored { score: score_of(title, url, words) + (if visits > 20 { 20 } else { visits }) + (if looked < 50 { 8 } else { 0 }), item: state.Item {
                    kind: "history", icon: "history", title: state.brand_title(title, url), sub: pretty_host(url), act: "open", arg: url, hint: kit.ago(kit.gn(m, "at", 0.0)), hue: kit.hue_of(kit.site_of(url)) } })
            }
        }
        for it in top(found, 4) { out.push(it) }
    }

    if mode == "all" or mode == "commands" {
        var found: [Scored] = []
        for cm in commands() {
            var s = 0
            if q == "" { s = 1 }
            else if contains_all(cm.title + " " + cm.words, words) { s = score_of(cm.title, "", words) + 4 }
            if s > 0 {
                var hint = ""
                if cm.key != "" { hint = to_text(a.keys.get(cm.key) ?? "") }
                found.push(Scored { score: s, item: state.Item { kind: "command", icon: cm.icon, title: cm.title, sub: "", act: "cmd", arg: cm.id, hint: pretty_key(hint) } })
            }
        }
        var limit = 4
        if mode == "commands" { limit = 14 }
        if q == "" and mode == "all" { limit = 6 }
        for it in top(found, limit) { out.push(it) }
    }
    give out
}

~~ cmd+shift+t  ->  ⇧⌘T
pub fn pretty_key(k: Text) -> Text {
    if k == "" { give "" }
    var out = ""
    var key = ""
    for part in k.split("+") {
        let p = part.trim().lower()
        if p == "ctrl" { out = out + "⌃" }
        else if p == "alt" or p == "opt" or p == "option" { out = out + "⌥" }
        else if p == "shift" { out = out + "⇧" }
        else if p == "cmd" or p == "command" { out = out + "⌘" }
        else if p == "tab" { key = "⇥" }
        else if p == "enter" or p == "return" { key = "↩" }
        else if p == "esc" { key = "⎋" }
        else { key = p.upper() }
    }
    give out + key
}

~~ ---------------------------------------------------------- history
pub fn record_visit(a: state.App, url: Text, title: Text) {
    if not settings.flag(a.s, "history") { give }
    if url.starts_with("sreon://") or url.starts_with("about:") or not (url.starts_with("http://") or url.starts_with("https://")) { give }
    let now = time.now()
    var i = a.history.len() - 1
    var scanned = 0
    while i >= 0 and scanned < 400 {
        let m: Map<Text, Any> = a.history[i]
        if kit.gt(m, "u") == url {
            var n = kit.gi(m, "n", 1)
            m.set("n", n + 1)
            if title != "" { m.set("t", title) }
            m.set("at", now)
            a.history[i] = m
            give
        }
        i = i - 1
        scanned = scanned + 1
    }
    a.history.push(["u": url, "t": title, "at": now, "n": 1])
    if a.history.len() % 20 == 0 { state.save_history(a) }
}
