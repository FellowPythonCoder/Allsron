~~ =====================================================================
~~  Sreon — omnibox
~~
~~  What a typed line means, what to suggest while it is being typed, and
~~  how links are cleaned. Everything here is local: suggestions come
~~  from your own tabs, bookmarks and history, so the bar answers before
~~  a network could.
~~ =====================================================================
module omnibox

use std.http
use std.time
use kit
use settings
use state
use units
use calc

pub fn engine_template(s: Map<Text, Any>) -> Text {
    let e = settings.str(s, "engine")
    if e == "brave" { give "https://search.brave.com/search?q=%s" }
    if e == "startpage" { give "https://www.startpage.com/do/search?q=%s" }
    if e == "ecosia" { give "https://www.ecosia.org/search?q=%s" }
    if e == "qwant" { give "https://www.qwant.com/?q=%s" }
    if e == "mojeek" { give "https://www.mojeek.com/search?q=%s" }
    if e == "bing" { give "https://www.bing.com/search?q=%s" }
    if e == "yahoo" { give "https://search.yahoo.com/search?p=%s" }
    if e == "kagi" { give "https://kagi.com/search?q=%s" }
    if e == "custom" {
        let c = settings.str(s, "engine_custom")
        if c.contains("%s") { give c }
    }
    give "https://duckduckgo.com/?q=%s"
}

~~ Developer search: one engine of your choice for code questions.
pub fn dev_template(s: Map<Text, Any>) -> Text {
    let e = settings.str(s, "dev_engine")
    if e == "github" { give "https://github.com/search?q=%s&type=code" }
    if e == "mdn" { give "https://developer.mozilla.org/en-US/search?q=%s" }
    if e == "devdocs" { give "https://devdocs.io/#q=%s" }
    if e == "sourcegraph" { give "https://sourcegraph.com/search?q=%s" }
    if e == "grep" { give "https://grep.app/search?q=%s" }
    if e == "custom" {
        let c = settings.str(s, "dev_engine_custom")
        if c.contains("%s") { give c }
    }
    give "https://stackoverflow.com/search?q=%s"
}

~~ Built-in developer shortcuts: "gh rust async", "!npm lodash".
pub fn dev_bang(key: Text) -> Text {
    if key == "gh" { give "https://github.com/search?q=%s" }
    if key == "so" { give "https://stackoverflow.com/search?q=%s" }
    if key == "mdn" { give "https://developer.mozilla.org/en-US/search?q=%s" }
    if key == "npm" { give "https://www.npmjs.com/search?q=%s" }
    if key == "crates" { give "https://crates.io/search?q=%s" }
    if key == "pypi" { give "https://pypi.org/search/?q=%s" }
    if key == "docsrs" { give "https://docs.rs/releases/search?query=%s" }
    if key == "devdocs" { give "https://devdocs.io/#q=%s" }
    if key == "mvn" { give "https://central.sonatype.com/search?q=%s" }
    if key == "go" { give "https://pkg.go.dev/search?q=%s" }
    if key == "hn" { give "https://hn.algolia.com/?q=%s" }
    if key == "caniuse" { give "https://caniuse.com/?search=%s" }
    if key == "bundle" { give "https://bundlephobia.com/package/%s" }
    if key == "rfc" { give "https://datatracker.ietf.org/doc/search?name=%s" }
    give ""
}

pub fn search_url(s: Map<Text, Any>, q: Text) -> Text {
    give engine_template(s).replace("%s", http.url_encode(q))
}

pub object Verdict {
    kind: Text = "search"       ~~ url, search, internal, keyword
    url: Text = ""
    label: Text = ""
}

fn is_ip(h: Text) -> Bool {
    let parts = h.split(".")
    if parts.len() != 4 { give false }
    for p in parts {
        let n = p.to_int()
        if n == nil { give false }
        let v = n ?? 0
        if v < 0 or v > 255 { give false }
    }
    give true
}

~~ A host name: letters, digits, dots and dashes, ending in a plausible domain.
fn is_host(h: Text) -> Bool {
    if h == "localhost" or is_ip(h) { give true }
    if not h.contains(".") { give false }
    if h.starts_with(".") or h.ends_with(".") { give false }
    let parts = h.split(".")
    let tld = parts[parts.len() - 1]
    if tld.len() < 2 or tld.len() > 24 { give false }
    for c in h.chars() {
        let ok = (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9") or c == "-" or c == "." or c == "_" or c >= "\u{80}"
        if not ok { give false }
    }
    for c in tld.chars() { if c >= "0" and c <= "9" { give false } }
    give true
}

pub fn classify(a: state.App, input: Text) -> Verdict {
    let t = input.trim()
    if t == "" { give Verdict { kind: "internal", url: "sreon://newtab" } }
    if t.starts_with("sreon://") or t.starts_with("about:") {
        if t == "about:blank" { give Verdict { kind: "url", url: "about:blank" } }
        if t.starts_with("about:") { give Verdict { kind: "internal", url: "sreon://" + t.slice(6, t.len()) } }
        give Verdict { kind: "internal", url: t }
    }
    let low = t.lower()
    if low.starts_with("http://") or low.starts_with("https://") or low.starts_with("file://") or low.starts_with("data:") {
        if not t.contains(" ") { give Verdict { kind: "url", url: t } }
    }
    ~~ keyword shortcuts: "yt cats"
    let sp = t.index_of(" ")
    if sp > 0 {
        let key = t.slice(0, sp).lower()
        let rest = t.slice(sp + 1, t.len()).trim()
        for line in settings.str(a.s, "keywords").lines() {
            let eq = line.index_of("=")
            if eq > 0 and line.slice(0, eq).trim().lower() == key and rest != "" {
                let tpl = line.slice(eq + 1, line.len()).trim()
                give Verdict { kind: "keyword", url: tpl.replace("%s", http.url_encode(rest)), label: key }
            }
        }
    }
    if sp > 0 and settings.flag(a.s, "dev_bangs") {
        var key = t.slice(0, sp).lower()
        let rest = t.slice(sp + 1, t.len()).trim()
        if key.starts_with("!") { key = key.slice(1, key.len()) }
        let pre = settings.str(a.s, "dev_prefix").trim().lower()
        if rest != "" {
            let tpl = dev_bang(key)
            if tpl != "" { give Verdict { kind: "keyword", url: tpl.replace("%s", http.url_encode(rest)), label: key } }
            if pre != "" and key == pre { give Verdict { kind: "keyword", url: dev_template(a.s).replace("%s", http.url_encode(rest)), label: key } }
        }
    }
    if not t.contains(" ") {
        var host = t
        var tail = ""
        let cut = t.index_of("/")
        if cut >= 0 { host = t.slice(0, cut); tail = t.slice(cut, t.len()) }
        var port = ""
        let colon = host.index_of(":")
        if colon >= 0 { port = host.slice(colon, host.len()); host = host.slice(0, colon) }
        let q = host.index_of("?")
        if q >= 0 { tail = host.slice(q, host.len()) + tail; host = host.slice(0, q) }
        if is_host(host) {
            let local = host == "localhost" or is_ip(host) or host.ends_with(".local")
            var scheme = "https://"
            if local { scheme = "http://" }
            give Verdict { kind: "url", url: scheme + host + port + tail }
        }
    }
    give Verdict { kind: "search", url: search_url(a.s, t), label: t }
}

~~ ------------------------------------------------------ cleaning links
fn tracking(name: Text) -> Bool {
    let n = name.lower()
    if n.starts_with("utm_") or n.starts_with("mtm_") or n.starts_with("pk_") or n.starts_with("hsa_") or n.starts_with("ga_") { give true }
    for x in ["fbclid", "gclid", "gclsrc", "dclid", "msclkid", "yclid", "twclid", "ttclid", "li_fat_id", "igshid", "igsh", "mc_cid", "mc_eid",
              "_hsenc", "_hsmi", "mkt_tok", "wickedid", "oly_enc_id", "oly_anon_id", "vero_id", "__s", "_openstat", "s_cid", "cmpid",
              "ncid", "_ga", "_gl", "trk", "trkcampaign", "trkinfo", "spm", "scid", "ref_src", "ref_url", "rb_clickid", "sr_share",
              "si", "feature", "pp", "soc_src", "soc_trk", "mbid", "elqtrackid", "elq", "elqaid", "elqat", "cid_", "sc_cid", "campaignid", "adgroupid", "ei_"] {
        if n == x { give true }
    }
    give false
}

pub fn clean_url(url: Text) -> Text {
    let q = url.index_of("?")
    if q < 0 { give url }
    var frag = ""
    var body = url
    let h = body.index_of("#")
    if h >= 0 { frag = body.slice(h, body.len()); body = body.slice(0, h) }
    let base = body.slice(0, q)
    let query = body.slice(q + 1, body.len())
    var keep: [Text] = []
    for pair in query.split("&") {
        if pair == "" { skip }
        let eq = pair.index_of("=")
        let name = if eq >= 0 { pair.slice(0, eq) } else { pair }
        ~~ "feature" and "si" only matter on video sites; keep them elsewhere
        var dropped = tracking(name)
        if dropped and (name.lower() == "si" or name.lower() == "feature" or name.lower() == "pp") {
            dropped = url.contains("youtube.com") or url.contains("youtu.be") or url.contains("spotify.com")
        }
        if not dropped { keep.push(pair) }
    }
    if keep.len() == 0 { give base + frag }
    give base + "?" + keep.join("&") + frag
}

pub fn pretty_host(url: Text) -> Text {
    if url.starts_with("sreon://") { give "Sreon · " + url.slice(8, url.len()) }
    let h = kit.site_of(url)
    if h == "" { give url }
    give h
}

~~ ----------------------------------------------------------- commands
pub object Cmd {
    id: Text = ""
    title: Text = ""
    words: Text = ""
    icon: Text = ""
    key: Text = ""
}

fn c(id: Text, title: Text, words: Text, icon: Text, key: Text) -> Cmd {
    give Cmd { id: id, title: title, words: words, icon: icon, key: key }
}

