~~ =====================================================================
~~  Sreon — settings
~~
~~  Every option is declared once, here: its key, its kind, its default
~~  and the words shown next to it. The settings page is drawn from this
~~  list, so adding a line here adds a control there.
~~ =====================================================================
module settings

use std.json
use kit
use store

pub object Def {
    group: Text = ""
    key: Text = ""
    kind: Text = "toggle"
    label: Text = ""
    hint: Text = ""
    fallback: Any = ""
    options: [Text] = []
    lo: Int = 0
    hi: Int = 100
}

fn toggle(group: Text, key: Text, label: Text, hint: Text, yes: Bool) -> Def {
    give Def { group: group, key: key, kind: "toggle", label: label, hint: hint, fallback: yes }
}

fn choice(group: Text, key: Text, label: Text, hint: Text, first: Text, options: [Text]) -> Def {
    give Def { group: group, key: key, kind: "choice", label: label, hint: hint, fallback: first, options: options }
}

fn range(group: Text, key: Text, label: Text, hint: Text, start: Int, lo: Int, hi: Int) -> Def {
    give Def { group: group, key: key, kind: "range", label: label, hint: hint, fallback: start, lo: lo, hi: hi }
}

fn text(group: Text, key: Text, label: Text, hint: Text, start: Text) -> Def {
    give Def { group: group, key: key, kind: "text", label: label, hint: hint, fallback: start }
}

fn area(group: Text, key: Text, label: Text, hint: Text, start: Text) -> Def {
    give Def { group: group, key: key, kind: "area", label: label, hint: hint, fallback: start }
}

fn colour(group: Text, key: Text, label: Text, hint: Text, start: Text) -> Def {
    give Def { group: group, key: key, kind: "color", label: label, hint: hint, fallback: start }
}

pub fn groups() -> [[Text]] {
    give [["appearance", "Appearance", "contrast"], ["sidebar", "Sidebar & tabs", "sidebar"], ["newtab", "New tab", "newtab"],
          ["search", "Search", "search"], ["shield", "Shield", "shield"], ["privacy", "Privacy", "eye-off"],
          ["speed", "Speed", "bolt"], ["startup", "Startup", "power"], ["studio", "Studio", "code"],
          ["keys", "Shortcuts", "command"], ["advanced", "Advanced", "sliders"]]
}

