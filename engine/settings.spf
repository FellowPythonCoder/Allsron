~~ ----------------------------------------------------------- shortcuts
pub fn actions() -> [[Text]] {
    give [["new_tab", "New tab", "cmd+t"], ["close_tab", "Close tab", "cmd+w"],
          ["reopen_tab", "Reopen closed tab", "cmd+shift+t"], ["palette", "Open the bar", "cmd+l"],
          ["search_tabs", "Search tabs and everything", "cmd+k"],
          ["toggle_sidebar", "Show or hide the sidebar", "cmd+s"], ["toggle_panel", "Show or hide the right panel", "cmd+."],
          ["reader", "Reader", "cmd+shift+r"], ["brief", "Brief this page", "cmd+shift+b"],
          ["focus", "Focus mode", "cmd+shift+f"], ["find", "Find in page", "cmd+f"],
          ["studio", "Open Studio", "cmd+shift+s"], ["settings", "Settings", "cmd+,"],
          ["back", "Back", "cmd+["], ["forward", "Forward", "cmd+]"], ["reload", "Reload", "cmd+r"],
          ["zoom_in", "Zoom in", "cmd+="], ["zoom_out", "Zoom out", "cmd+-"], ["zoom_reset", "Actual size", "cmd+0"],
          ["split", "Split view", "cmd+shift+d"], ["next_tab", "Next tab", "ctrl+tab"], ["prev_tab", "Previous tab", "ctrl+shift+tab"],
          ["pin_tab", "Pin or unpin tab", "cmd+shift+p"], ["screenshot", "Screenshot of the page", "cmd+shift+4"],
          ["copy_link", "Copy clean link", "cmd+shift+c"], ["sleep_tab", "Put this tab to sleep", "cmd+shift+z"],
          ["whiteboard", "Open Whiteboard", "cmd+shift+w"], ["new_window", "New window", "cmd+n"], ["private", "New private window", "cmd+shift+n"]]
}

~~ ---------------------------------------------------------- the values
pub fn defaults() -> Map<Text, Any> {
    var m: Map<Text, Any> = [:]
    for def in defs() { m.set(def.key, def.fallback) }
    give m
}

pub fn load() -> Map<Text, Any> {
    var m = defaults()
    let saved = store.read_map("settings")
    for k in saved.keys() {
        if m.has(k) { m.set(k, saved.get(k) ?? "") }
    }
    give m
}

pub fn save(m: Map<Text, Any>) {
    var diff: Map<Text, Any> = [:]
    let base = defaults()
    for k in m.keys() {
        let a = json.write(m.get(k) ?? "")
        let b = json.write(base.get(k) ?? "")
        if a != b { diff.set(k, m.get(k) ?? "") }
    }
    store.write("settings", diff)
}

pub fn shortcuts() -> Map<Text, Any> {
    var m: Map<Text, Any> = [:]
    for a in actions() { m.set(a[0], a[2]) }
    let saved = store.read_map("shortcuts")
    for k in saved.keys() { if m.has(k) { m.set(k, saved.get(k) ?? "") } }
    give m
}

pub fn def_of(key: Text) -> Def {
    for d in defs() { if d.key == key { give d } }
    give Def { }
}

pub fn flag(m: Map<Text, Any>, key: Text) -> Bool => kit.gb(m, key, false)
pub fn str(m: Map<Text, Any>, key: Text) -> Text => kit.gt(m, key)
pub fn int(m: Map<Text, Any>, key: Text) -> Int => kit.gi(m, key, 0)

~~ Coerce whatever the page sent to the kind the setting expects.
pub fn coerce(def: Def, raw: Any) -> Any {
    let t = to_text(raw)
    if def.kind == "toggle" { give t == "true" or t == "1" }
    if def.kind == "range" {
        let n = to_int(t.to_num() ?? to_num(to_int(to_text(def.fallback).to_num() ?? 0.0)))
        give kit.clamp_i(n, def.lo, def.hi)
    }
    if def.kind == "choice" {
        for o in def.options { if o == t { give t } }
        give def.fallback
    }
    give t
}
