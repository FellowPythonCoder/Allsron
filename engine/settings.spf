    d.push(range("appearance", "blur", "Glass blur", "How frosted the translucent surfaces look.", 28, 0, 48))
    d.push(toggle("appearance", "glass", "Translucent window", "Let your desktop show faintly through the sidebar.", true))
    d.push(choice("appearance", "density", "Density", "How much room each row gets.", "comfortable",
                  ["cozy", "comfortable", "compact"]))
    d.push(toggle("appearance", "motion", "Animations", "Turn off for instant, motionless changes.", true))
    d.push(toggle("appearance", "dark_pages", "Dark mode for websites", "Darken light pages. Images and video stay as they are.", false))

    ~~ -------------------------------------------------- sidebar & tabs
    d.push(choice("sidebar", "side", "Sidebar position", "Tabs on the left or right edge.", "left", ["left", "right"]))
    d.push(range("sidebar", "side_width", "Sidebar width", "In points. Drag-free and exact.", 264, 200, 380))
    d.push(choice("sidebar", "side_mode", "Sidebar style", "Expanded shows titles, compact shows only icons, hidden is on demand.",
                  "expanded", ["expanded", "compact", "hidden"]))
        d.push(toggle("sidebar", "tab_close_hover", "Close button on hover", "Otherwise every tab always shows one.", true))
    d.push(toggle("sidebar", "new_tab_next", "Open new tabs next to this one", "Otherwise they go to the end.", true))
    d.push(toggle("sidebar", "panel_open", "Keep the right panel open", "Shield, Brief, Notes and Tools beside every page.", false))
    d.push(range("sidebar", "panel_width", "Right panel width", "In points.", 340, 280, 520))
    d.push(toggle("sidebar", "toolbar_labels", "Show the full address", "Otherwise just the site name.", false))
