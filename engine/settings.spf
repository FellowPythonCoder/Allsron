    d.push(text("newtab", "name", "Your name", "Used only for the greeting, kept on this Mac.", ""))
    d.push(toggle("newtab", "nt_dock", "Show the dock", "Your apps along the bottom, like a desktop.", true))
    d.push(toggle("newtab", "nt_clock", "Show the clock", "", true))
    d.push(toggle("newtab", "clock_24h", "24-hour clock", "", false))
    d.push(toggle("newtab", "nt_search", "Show the search box", "", true))
