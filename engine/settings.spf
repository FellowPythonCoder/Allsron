    d.push(area("newtab", "dial", "Favourite sites", "One per line:  name | address", "Wikipedia | https://wikipedia.org\nGitHub | https://github.com\nHacker News | https://news.ycombinator.com\nYouTube | https://youtube.com\nReddit | https://reddit.com\nSreon Studio | sreon://studio"))

    ~~ --------------------------------------------------------- search
    d.push(choice("search", "engine", "Search engine", "Sreon never adds tracking of its own to a search.", "duckduckgo",
                  ["duckduckgo", "brave", "startpage", "ecosia", "qwant", "mojeek", "bing", "yahoo", "kagi", "custom"]))
