~~ =====================================================================
~~  Sreon — guide
~~
~~  The guidebook, drawn properly. The thirty-two chapters are plain
~~  Markdown; this turns them into pages with a hero picture for each
~~  chapter, runnable code cards, callouts and diagrams.
~~ =====================================================================
module guide

use std.fs
use kit
use store
use state
use icons
use hl

pub object Chapter {
    n: Int = 0
    file: Text = ""
    title: Text = ""
    group: Int = 0
    body: Text = ""
}

pub fn group_names() -> [Text] => ["Foundations", "Structure", "Craft", "Make things", "Mastery"]
pub fn group_hue(g: Int) -> Int {
    let hues = [265, 205, 160, 330, 28]
    give hues[kit.clamp_i(g, 0, 4)]
}

fn group_of(n: Int) -> Int {
    if n == 31 { give 0 }
    if n == 32 { give 3 }
    if n <= 8 { give 0 }
    if n <= 14 { give 1 }
    if n <= 19 { give 2 }
    if n <= 24 { give 3 }
    give 4
}

pub fn chapters() -> [Chapter] {
    var out: [Chapter] = []
    var files = fs.list(store.res_dir() + "/guidebook")
    files = files.sort()
    for f in files {
        if not f.ends_with(".md") { skip }
        let n = f.slice(0, 2).to_int() ?? 0
        let body = fs.read(store.res_dir() + "/guidebook/" + f) ?? ""
        var title = f
        for line in body.split("\n") {
            if line.starts_with("# ") { title = line.slice(2, line.len()).trim(); break }
        }
        out.push(Chapter { n: n, file: f, title: title, group: group_of(n), body: body })
    }
    give out
}

pub fn chapter(n: Int) -> Chapter {
    for c in chapters() { if c.n == n { give c } }
    give Chapter { }
}

~~ ---------------------------------------------------------- inline text
fn sub(cs: [Text], a: Int, b: Int) -> Text {
    var s = ""
    var i = a
    while i < b and i < cs.len() { s = s + cs[i]; i = i + 1 }
    give s
}

fn find_from(cs: [Text], start: Int, pat: Text) -> Int {
    let w = pat.len()
    var i = start
    while i + w <= cs.len() {
        if cs[i] == pat.slice(0, 1) and (w == 1 or cs[i + 1] == pat.slice(1, 2)) { give i }
        i = i + 1
    }
    give -1
}

pub fn inline(t: Text) -> Text {
    let cs = t.chars()
    let n = cs.len()
    var out = ""
    var i = 0
    while i < n {
        let c = cs[i]
        if c == "`" {
            let j = find_from(cs, i + 1, "`")
            if j > 0 { out = out + "<code>" + kit.esc(sub(cs, i + 1, j)) + "</code>"; i = j + 1; skip }
        }
        if c == "*" and i + 1 < n and cs[i + 1] == "*" {
            let j = find_from(cs, i + 2, "**")
            if j > 0 { out = out + "<strong>" + inline(sub(cs, i + 2, j)) + "</strong>"; i = j + 2; skip }
        }
        if c == "*" and i + 1 < n and cs[i + 1] != " " {
            let j = find_from(cs, i + 1, "*")
            if j > 0 and cs[j - 1] != " " { out = out + "<em>" + inline(sub(cs, i + 1, j)) + "</em>"; i = j + 1; skip }
        }
        if c == "[" {
            let j = find_from(cs, i + 1, "](")
            if j > 0 {
                let k = find_from(cs, j + 2, ")")
                if k > 0 { out = out + "<span class=\"lnk\">" + inline(sub(cs, i + 1, j)) + "</span>"; i = k + 1; skip }
            }
        }
        out = out + kit.esc(c)
        i = i + 1
    }
    give out
}

~~ ------------------------------------------------------------ code cards
fn code_card(code: Text, id: Text, sketch: Bool) -> Text {
    let runnable = code.contains("fn main") and not sketch
    let args = ["code": code, "into": "out-" + id]
    var h = "<div class=\"code\"><div class=\"code-h\"><span class=\"dots\"><i></i><i></i><i></i></span>"
    h = h + "<span class=\"cn\">" + kit.sel(sketch, "sketch — an idea, not yet runnable", kit.sel(runnable, "example.spf", "snippet.spf")) + "</span><span class=\"sp\"></span>"
    h = h + "<button class=\"btn sm\"" + views_act("st.code.load", ["code": code]) + ">" + icons.svg("code") + "Open in editor</button>"
    if runnable { h = h + "<button class=\"btn sm pri\"" + views_act("st.exec.run", args) + ">" + icons.svg("play") + "Run</button>" }
    h = h + "</div><pre class=\"hl\">" + hl.html(code) + "</pre>"
    if runnable { h = h + "<div class=\"gout\" data-region=\"out-" + id + "\"></div>" }
    give h + "</div>"
}

fn views_act(name: Text, args: Map<Text, Any>) -> Text => " data-act=\"" + name + "\" data-a=\"" + kit.jattr(args) + "\""

fn is_callout(p: Text) -> Bool {
    if not p.starts_with("**") { give false }
    let rest = p.slice(2, p.len())
    let k = rest.chars()
    let j = find_from(k, 0, "**")
    if j < 0 { give false }
    if j > 60 { give false }
    give true
}

fn callout(p: Text) -> Text {
    let low = p.lower()
    var kind = "k-note"
    var glyph = "spark"
    if low.contains("limitation") or low.contains("careful") or low.contains("warning") or low.contains("watch out") or low.contains("beware") { kind = "k-warn"; glyph = "shield" }
    if low.starts_with("**tip") or low.starts_with("**try") { kind = "k-tip"; glyph = "bolt" }
    give "<div class=\"callout " + kind + "\"><span class=\"ci\">" + icons.svg(glyph) + "</span><div>" + inline(p) + "</div></div>"
}

~~ ------------------------------------------------------- markdown → HTML
pub fn render(c: Chapter) -> Text {
    let lines = c.body.split("\n")
    var out = ""
    var i = 0
    var para: [Text] = []
    var items: [Text] = []
    var ordered = false
    var in_try = false
    var code_n = 0
    let n = lines.len()
    while i < n {
        let line = lines[i]
        let t = line.trim()
        ~~ flush helpers are inlined as small closures of state: we flush before every other block
        if t != "" and not t.starts_with("- ") and not t.starts_with("* ") and not (t.len() > 2 and t.slice(1, 3) == ". ") and not line.starts_with("  ") {
            if items.len() > 0 {
                let tag = kit.sel(ordered, "ol", "ul")
                out = out + "<" + tag + ">"
                for it in items { out = out + "<li>" + inline(it) + "</li>" }
                out = out + "</" + tag + ">"
                items = []
            }
        }
        if t == "" or t.starts_with("#") or t.starts_with("```") or t.starts_with("|") {
            if para.len() > 0 {
                let p = para.join(" ")
                out = out + kit.sel(is_callout(p), callout(p), "<p>" + inline(p) + "</p>")
                para = []
            }
            if t == "" and items.len() > 0 {
                let nxt = kit.sel(i + 1 < n, lines[kit.clamp_i(i + 1, 0, n - 1)], "")
                if not (nxt.starts_with("- ") or nxt.starts_with("  ") or nxt.trim().starts_with("* ")) {
                    let tag = kit.sel(ordered, "ol", "ul")
                    out = out + "<" + tag + ">"
                    for it in items { out = out + "<li>" + inline(it) + "</li>" }
                    out = out + "</" + tag + ">"
                    items = []
                }
            }
        }
        if t == "" { i = i + 1; skip }
        if t.starts_with("```") {
            let lang = t.slice(3, t.len()).trim()
            var code = ""
            i = i + 1
            while i < n and not lines[i].trim().starts_with("```") { code = code + lines[i] + "\n"; i = i + 1 }
            i = i + 1
            code_n = code_n + 1
            let id = c.n.to_text() + "-" + code_n.to_text()
            if lang == "sprfst" or lang == "sprfst-sketch" { out = out + code_card(code.trim(), id, lang == "sprfst-sketch") }
            else { out = out + "<pre class=\"term\"><span class=\"pr\">›</span>" + kit.esc(code.trim()) + "</pre>" }
            skip
        }
        if t.starts_with("# ") { i = i + 1; skip }
        if t.starts_with("## ") {
            if in_try { out = out + "</div>"; in_try = false }
            let h = t.slice(3, t.len())
            let low = h.lower()
            if low == "try it" or low == "exercise" or low == "exercises" or low.starts_with("exercise") {
                out = out + "<div class=\"exercise\"><div class=\"ex-h\">" + icons.svg("bolt") + "<span>" + inline(h) + "</span></div>"
                in_try = true
            }
            else { out = out + "<h2>" + inline(h) + "</h2>" }
            i = i + 1
            skip
        }
        if t.starts_with("### ") { out = out + "<h3>" + inline(t.slice(4, t.len())) + "</h3>"; i = i + 1; skip }
        if t.starts_with("|") {
            var rows: [Text] = []
            while i < n and lines[i].trim().starts_with("|") { rows.push(lines[i].trim()); i = i + 1 }
            var tb = "<div class=\"tbl\"><table>"
            var r = 0
            for row in rows {
                var inner = row
                if inner.starts_with("|") { inner = inner.slice(1, inner.len()) }
                if inner.ends_with("|") { inner = inner.slice(0, inner.len() - 1) }
                let cells = inner.split("|")
                if cells.len() > 0 and cells[0].trim().starts_with("---") { skip }
                if cells.len() > 0 and cells[0].trim().starts_with(":--") { skip }
                let tag = kit.sel(r == 0, "th", "td")
                tb = tb + "<tr>"
                for cell in cells { tb = tb + "<" + tag + ">" + inline(cell.trim()) + "</" + tag + ">" }
                tb = tb + "</tr>"
                r = r + 1
            }
            out = out + tb + "</table></div>"
            skip
        }
        if t.starts_with("- ") or t.starts_with("* ") {
            if para.len() > 0 { let p = para.join(" "); out = out + "<p>" + inline(p) + "</p>"; para = [] }
            ordered = false
            items.push(t.slice(2, t.len()))
            i = i + 1
            skip
        }
        if t.len() > 2 and t.slice(1, 3) == ". " and t.slice(0, 1) >= "0" and t.slice(0, 1) <= "9" {
            if para.len() > 0 { let p = para.join(" "); out = out + "<p>" + inline(p) + "</p>"; para = [] }
            ordered = true
            items.push(t.slice(3, t.len()))
            i = i + 1
            skip
        }
        if line.starts_with("  ") and items.len() > 0 {
            items[items.len() - 1] = items[items.len() - 1] + " " + t
            i = i + 1
            skip
        }
        para.push(t)
        i = i + 1
    }
    if para.len() > 0 { let p = para.join(" "); out = out + kit.sel(is_callout(p), callout(p), "<p>" + inline(p) + "</p>") }
    if items.len() > 0 {
        let tag = kit.sel(ordered, "ol", "ul")
        out = out + "<" + tag + ">"
        for it in items { out = out + "<li>" + inline(it) + "</li>" }
        out = out + "</" + tag + ">"
    }
    if in_try { out = out + "</div>" }
    give out
}

~~ ----------------------------------------------------------- hero art
pub fn hero_art(n: Int, hue: Int) -> Text {
    let h2 = (hue + 50) % 360
    var s = "<svg class=\"hero-art\" viewBox=\"0 0 800 220\" preserveAspectRatio=\"xMidYMid slice\" aria-hidden=\"true\">"
    s = s + "<defs><linearGradient id=\"hg" + n.to_text() + "\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"hsl(" + hue.to_text() + ",70%,34%)\"/><stop offset=\"1\" stop-color=\"hsl(" + h2.to_text() + ",75%,20%)\"/></linearGradient>"
    s = s + "<radialGradient id=\"hr" + n.to_text() + "\" cx=\".8\" cy=\".1\" r=\".7\"><stop offset=\"0\" stop-color=\"hsl(" + h2.to_text() + ",90%,70%)\" stop-opacity=\".55\"/><stop offset=\"1\" stop-color=\"transparent\"/></radialGradient></defs>"
    s = s + "<rect width=\"800\" height=\"220\" fill=\"url(#hg" + n.to_text() + ")\"/><rect width=\"800\" height=\"220\" fill=\"url(#hr" + n.to_text() + ")\"/>"
    let m = n % 6
    s = s + "<g fill=\"none\" stroke=\"#fff\" stroke-opacity=\".22\" stroke-width=\"1.5\">"
    if m == 0 {
        var r = 20
        while r <= 200 { s = s + "<circle cx=\"640\" cy=\"110\" r=\"" + r.to_text() + "\"/>"; r = r + 26 }
    }
    else if m == 1 {
        var x = 380
        while x < 860 { s = s + "<path d=\"M" + x.to_text() + " 240L" + (x + 160).to_text() + " -20\"/>"; x = x + 34 }
    }
    else if m == 2 {
        var y = 30
        while y < 220 { var x = 420; while x < 780 { s = s + "<circle cx=\"" + x.to_text() + "\" cy=\"" + y.to_text() + "\" r=\"3\" fill=\"#fff\" fill-opacity=\".4\" stroke=\"none\"/>"; x = x + 36 }; y = y + 36 }
    }
    else if m == 3 {
        var k = 0
        while k < 7 { s = s + "<path d=\"M380 " + (60 + k * 22).to_text() + " Q 500 " + (10 + k * 22).to_text() + " 600 " + (60 + k * 22).to_text() + " T 820 " + (60 + k * 22).to_text() + "\"/>"; k = k + 1 }
    }
    else if m == 4 {
        var k = 0
        while k < 6 { s = s + "<rect x=\"" + (470 + k * 20).to_text() + "\" y=\"" + (30 + k * 14).to_text() + "\" width=\"" + (240 - k * 30).to_text() + "\" height=\"" + (150 - k * 20).to_text() + "\" rx=\"" + (24 - k * 3).to_text() + "\"/>"; k = k + 1 }
    }
    else {
        s = s + "<path d=\"M420 180 L520 60 L620 150 L720 40\"/><circle cx=\"420\" cy=\"180\" r=\"7\"/><circle cx=\"520\" cy=\"60\" r=\"7\"/><circle cx=\"620\" cy=\"150\" r=\"7\"/><circle cx=\"720\" cy=\"40\" r=\"7\"/><path d=\"M420 200H760\" stroke-dasharray=\"4 8\"/>"
    }
    s = s + "</g><text x=\"760\" y=\"205\" text-anchor=\"end\" font-size=\"150\" font-weight=\"800\" fill=\"#fff\" fill-opacity=\".08\" font-family=\"-apple-system,SF Pro Display,sans-serif\">" + kit.pad2(n) + "</text></svg>"
    give s
}

pub fn pipeline_svg() -> Text {
    var s = "<svg class=\"diagram\" viewBox=\"0 0 860 190\" role=\"img\" aria-label=\"How a SPRFST program runs\">"
    s = s + "<defs><linearGradient id=\"pg\" x1=\"0\" x2=\"1\"><stop offset=\"0\" stop-color=\"var(--accent)\"/><stop offset=\"1\" stop-color=\"var(--accent2)\"/></linearGradient><marker id=\"ar\" markerWidth=\"8\" markerHeight=\"8\" refX=\"6\" refY=\"4\" orient=\"auto\"><path d=\"M0 0L7 4L0 8z\" fill=\"var(--muted)\"/></marker></defs>"
    let names = ["Source", "Lexer", "Parser", "Checker", "Bytecode", "VM"]
    let notes = [".spf text", "tokens", "syntax tree", "types + names", "compact code", "runs fast"]
    var k = 0
    while k < 6 {
        let x = 14 + k * 140
        let hot = k == 5
        s = s + "<rect x=\"" + x.to_text() + "\" y=\"50\" width=\"108\" height=\"70\" rx=\"18\" fill=\"" + kit.sel(hot, "url(#pg)", "var(--surface2)") + "\" stroke=\"var(--line)\"/>"
        s = s + "<text x=\"" + (x + 54).to_text() + "\" y=\"82\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"650\" fill=\"" + kit.sel(hot, "#fff", "var(--text)") + "\">" + names[k] + "</text>"
        s = s + "<text x=\"" + (x + 54).to_text() + "\" y=\"102\" text-anchor=\"middle\" font-size=\"11\" fill=\"" + kit.sel(hot, "#ffffffcc", "var(--muted)") + "\">" + notes[k] + "</text>"
        if k < 5 { s = s + "<path d=\"M" + (x + 112).to_text() + " 85H" + (x + 134).to_text() + "\" stroke=\"var(--muted)\" stroke-width=\"1.5\" marker-end=\"url(#ar)\"/>" }
        k = k + 1
    }
    s = s + "<text x=\"430\" y=\"160\" text-anchor=\"middle\" font-size=\"12\" fill=\"var(--muted)\">Every step is written in C and lives in one small binary. Sreon itself is a SPRFST program.</text>"
    give s + "</svg>"
}

~~ ----------------------------------------------------------- cheat sheet
pub fn cheats() -> [[Text]] {
    give [
        ["Hello", r"""use std.io

fn main() {
    io.say("hello, Sreon")
}"""],
        ["Names", r"""let fixed = 10
var moving = 1
moving = moving + fixed
let label = "total: {moving}" """],
        ["Decisions", r"""if score > 90 {
    io.say("top")
} else if score > 50 {
    io.say("pass")
} else {
    io.say("again")
}"""],
        ["Loops", r"""for n in [1, 2, 3] { io.say("{n}") }

var i = 0
while i < 3 { i = i + 1 }

loop { break }"""],
        ["Functions", r"""fn area(w: Num, h: Num) -> Num {
    give w * h
}

fn double(x: Int) -> Int => x * 2"""],
        ["Lists and maps", r"""var xs = [3, 1, 2]
xs.push(9)
let sorted = xs.sort()

var ages: Map<Text, Int> = ["ada": 36]
ages.set("lin", 41)"""],
        ["Objects", r"""object Point {
    x: Num = 0.0
    y: Num = 0.0

    fn len(self) -> Num => math.sqrt(self.x * self.x + self.y * self.y)
}"""],
        ["Missing values", r"""let name = lookup("ada") ?? "unknown"
if found == nil { skip }"""]
    ]
}
